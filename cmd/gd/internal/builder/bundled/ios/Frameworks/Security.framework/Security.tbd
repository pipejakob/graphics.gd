--- !tapi-tbd
tbd-version:  4
install-name: '/System/Library/Frameworks/Security.framework/Security'  # expected location for the implementation on IOS (no Versions/A on embedded platforms)
targets:
 - arm64-ios
exports:
 - targets: [ arm64-ios ]
   symbols: # the required symbols to compile Go code, see crypto/x509/internal/macos
    - _SecCertificateCopyData
    - _SecCertificateCreateWithData
    - _SecPolicyCreateSSL
    - _SecTrustCopyCertificateChain
    - _SecTrustCreateWithCertificates
    - _SecTrustEvaluateWithError
    - _SecTrustGetCertificateAtIndex
    - _SecTrustGetCertificateCount
    - _SecTrustSetVerifyDate
...
